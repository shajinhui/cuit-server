<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginBottom="8dp">
    <TextView android:id="@+id/widget_course_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="高等数学" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_text"
        android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/widget_course_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="08:20–10:00" android:textSize="12sp" android:textColor="@color/widget_accent"
        android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/widget_course_room" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="H1208" android:textSize="11sp" android:textColor="@color/widget_muted"
        android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
