<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/schedule_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="今日课程" android:textSize="16sp"
            android:textStyle="bold" android:textColor="@color/widget_accent" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="10月8日" android:textSize="11sp" android:textColor="@color/widget_muted" />
    </LinearLayout>
    <TextView android:id="@+id/widget_week" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:text="星期四 · 第 5 周" android:textSize="11sp" android:textColor="@color/widget_muted" />
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:text="登录后查看今日课程"
        android:textSize="15sp" android:textColor="@color/widget_text" android:maxLines="3" android:ellipsize="end" />
    <LinearLayout android:id="@+id/widget_courses" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="成信友友 · 点击查看课表" android:textSize="10sp"
        android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
