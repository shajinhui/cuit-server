APP_ADDR=127.0.0.1:8888
APP_COOKIE_SECURE=false
APP_CORS_ORIGIN=http://127.0.0.1:5173
SQLITE_PATH='data/cuit-server.db'
REDIS_URL='redis://127.0.0.1:6379/0'
LOGIN_MAX_CONCURRENCY=200
LOGIN_FAIL_MAX_ACCOUNT=5
LOGIN_FAIL_MAX_IP=20
JWXT_CREDENTIAL_KEY='replace-with-base64-encoded-32-byte-key'
ADMIN_STATS_TOKEN='replace-with-random-admin-token'
LABMS_SCHEDULE_MODE=off
LABMS_SCHEDULE_ROLLOUT_PERCENT=0
# AutoRun 未配置密钥时整组接口保持关闭。APP_SECRET 与加密密钥只放服务端。
AUTORUN_APP_KEY='replace-with-upstream-app-key'
AUTORUN_APP_SECRET='replace-with-upstream-app-secret'
AUTORUN_SESSION_ENCRYPTION_KEY='replace-with-at-least-16-random-characters'
# 从 Cloudflare Worker 切换前保持 false，避免两边重复执行签到/签退。
AUTORUN_SCHEDULER_ENABLED=false
AUTORUN_SCHEDULER_WORKERS=10
AUTORUN_SCHEDULER_JOBS_PER_SECOND=5
