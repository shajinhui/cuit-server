{
  "name": "chengxin-youyou-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:android": "vue-tsc --noEmit && vite build --mode android",
    "check": "pnpm lint && pnpm test && pnpm run typecheck && pnpm run build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "android:sync": "pnpm run build:android && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "26.1.1",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.7",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
